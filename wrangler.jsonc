{
  // Cloudflare Workers の設定。統合フロー(Workers Builds)で `npx wrangler deploy` が読む。
  // このサイトは「静的アセット + 最小の Worker(API用)」構成。
  // - assets.directory "." … リポジトリ直下の静的ファイル(index.html/css/js/content/icons等)を配信
  // - main worker/index.js … /api/* などサーバー側処理。静的アセットに無いパスだけ Worker が処理する
  // 公開しない内部ファイルは .assetsignore で除外している。
  "name": "antenna-ai",
  "compatibility_date": "2026-08-22",
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // ニュースレター登録者を保存する KV(worker の env.SUBSCRIBERS)
  "kv_namespaces": [
    { "binding": "SUBSCRIBERS", "id": "71605517d80c48219d92723382968667" }
  ],
  // ニュースレター配信の定時実行。冪等(同じ号は再送しない)なので複数回でも安全=取りこぼしに強い。
  //   本番: JST 7:30 / 8:00 / 8:30(= UTC 22:30 / 23:00 / 23:30)。7:00の記事更新後に新しい号を検知して配信。
  //   一時: "*/5 * * * *" は cron が実際に発火するかの検証用。確認できたら削除する。
  "triggers": { "crons": ["*/5 * * * *", "30 22 * * *", "0 23 * * *", "30 23 * * *"] },
  // ダッシュボードで設定した環境変数(BREVO_API_KEY等)を自動デプロイで消さない
  "keep_vars": true
}
